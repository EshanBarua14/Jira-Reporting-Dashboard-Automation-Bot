# API Key for AI Executive Summaries & Intelligence Generation
GEMINI_API_KEY=""

# Host Application URL (Default: http://localhost:3000)
APP_URL="http://localhost:3000"

# Application Server Port (Port 3000 is required in AI Studio/container ingress)
PORT=3000

# Server Network Host Binding
# - In AI Studio / Container Preview: Set to "0.0.0.0" to allow reverse-proxy container ingress routing.
# - In Electron Desktop / Local Production: Set to "127.0.0.1" (loopback) to prevent exposing Express to the local LAN.
# - In Generic Server Production: Explicitly set according to deployment target (default safe fallback: 127.0.0.1).
HOST="0.0.0.0"

# Preview Iframe Embedding & Clickjacking Protection Mode
# - "true": Enables preview iframe embedding for AI Studio container preview environment (disables X-Frame-Options restriction).
# - "false": Enforces strict clickjacking defense with X-Frame-Options: SAMEORIGIN and CSP frame-ancestors 'self' (Default for Electron and Production).
PREVIEW_IFRAME="true"

# Desktop Environment Flag (automatically set to "true" by Electron launcher)
# Enforces loopback binding (127.0.0.1) and enables desktop-specific security protections.
IS_ELECTRON="false"
